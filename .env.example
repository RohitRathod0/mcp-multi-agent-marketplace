MISTRAL_API_KEY=your_mistral_api_key_here
MODEL_NAME=mistral-large-latest

# Per-request timeout for Mistral calls, in milliseconds (default 60000).
# Do not remove the bound: without a timeout a stalled connection raises nothing, so the
# retry/backoff wrapper never sees an error and a long eval run hangs forever instead of
# recovering. Raise it if you switch to a slower model.
# MISTRAL_TIMEOUT_MS=60000

# Minimum cosine similarity for retrieved context to count as grounding (default 0.30).
# Below this the retriever returns INSUFFICIENT_GROUNDING and no documents, rather than
# handing over the nearest match however unrelated. Calibrated against this corpus:
# in-domain queries score 0.474-0.710, out-of-domain 0.099 and below. Re-measure before
# changing it — a threshold carried over from a different corpus is only a guess.
# RAG_MIN_SIMILARITY=0.30

# Path to the synthetic SQLite marketplace store (default db/marketplace.db).
# MARKETPLACE_DB_PATH=db/marketplace.db

# How the orchestrator reaches the agent MCP servers.
#   stdio (default) - spawns each agent as a child process; used for local dev,
#                     standalone agent testing, and the eval harness.
#   http            - connects over the network; required under Docker Compose, where a
#                     stdio pipe cannot cross a container boundary.
# Leave this unset for local runs — docker-compose.yml sets it (and the URLs below) itself.
# MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=http. Defaults shown are for agents running on localhost;
# docker-compose.yml overrides them with Compose service names.
# PRICING_AGENT_URL=http://localhost:8001/mcp
# INVENTORY_AGENT_URL=http://localhost:8002/mcp
# RISK_SUPPORT_AGENT_URL=http://localhost:8003/mcp
